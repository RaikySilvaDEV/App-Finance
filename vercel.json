{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?route="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ]
}
