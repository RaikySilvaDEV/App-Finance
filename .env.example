# Optional: enables OpenAI financial analysis (server-side only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Use Ollama locally. On Vercel, set AI_PROVIDER=openai and configure OPENAI_API_KEY.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b

# Neon PostgreSQL connection string; required for Vercel deployments.
# DATABASE_URL_POOLED is also accepted if supplied by your database integration.
DATABASE_URL=

# Server binds locally by default; keep this on loopback for personal use.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# Required for personal read-only bank data through Meu Pluggy.
# Create a demo application in the Pluggy dashboard and keep the secret on the server.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Google OAuth web client. Register the exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# System administrator. Existing sole connection owner is preserved if blank.
FINPULSE_OWNER_EMAIL=
# Switch only after Pluggy approves this application for multiple users.
PLUGGY_CONNECTION_MODE=personal
PLUGGY_BUSINESS_ENABLED=false

# Market data: keep the key on the server. Public ticker access is limited.
BRAPI_API_KEY=
# Transactional email requires a Resend account and verified sending domain.
RESEND_API_KEY=
RESEND_FROM=
# Daily reminder endpoint: configure the same random secret in Vercel Production.
CRON_SECRET=
# On Vercel, set APP_URL to the public HTTPS origin of this app.
